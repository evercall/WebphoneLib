{
  "name": "webphone-lib",
  "version": "0.2.27",
  "description": "Webphone Lib",
  "author": "Open VoIP Alliance",
  "license": "MIT",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "npx rimraf@latest -g dist/* build/*",
    "build": "rollup -c",
    "build-watch": "rollup -cw",
    "serve": "serve -l 1235",
    "demo": "run-p build-watch serve",
    "typecheck": "tsc",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prepare": "npm run lint && npm run build",
    "test": "ava",
    "test-coverage": "nyc ava",
    "test-watch": "ava --watch",
    "docs": "typedoc --out docs src",
    "run-e2e-tests-in-docker": "docker-compose up --exit-code-from"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "ava": {
    "require": [
      "esm",
      "ts-node/register",
      "./test/_setup-browser-env.js"
    ],
    "extensions": [
      "ts"
    ],
    "babel": false,
    "compileEnhancements": false
  },
  "nyc": {
    "require": [
      "ts-node/register"
    ],
    "extends": "@istanbuljs/nyc-config-typescript",
    "all": true,
    "check-coverage": true,
    "include": [
      "src/**/*.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:open-voip-alliance/WebphoneLib.git"
  },
  "files": [
    "src",
    "dist",
    "test",
    "README.md"
  ],
  "dependencies": {
    "p-retry": "^4.1.0",
    "p-timeout": "^3.2.0",
    "sip.js": "0.15.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/events": "^3.0.3",
    "@types/node": "^25.6.0",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "ava": "^7.0.0",
    "ava-fast-check": "^6.0.0",
    "base": "^3.0.0",
    "browser-env": "^3.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-check": "^3.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "prettier": "^3.8.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "serve": "^14.2.6",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.2"
  }
}
